[Unit]
Description=tor-cms (loopback-only, serve via Tor hidden service)
After=network.target tor.service
Wants=tor.service

[Service]
Type=simple
# Create a dedicated unprivileged user: sudo useradd -r -s /usr/sbin/nologin torcms
User=torcms
Group=torcms
WorkingDirectory=/opt/tor-cms
ExecStart=/opt/tor-cms/tor-cms
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tor-cms
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
