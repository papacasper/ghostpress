[Unit]
Description=ghostpress (loopback-only, serve via Tor hidden service)
After=network.target tor.service
Wants=tor.service

[Service]
Type=simple
# Create a dedicated unprivileged user: sudo useradd -r -s /usr/sbin/nologin ghostpress
User=ghostpress
Group=ghostpress
WorkingDirectory=/opt/ghostpress
ExecStart=/opt/ghostpress/ghostpress
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ghostpress
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
